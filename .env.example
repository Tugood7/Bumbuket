# ==============================================================================
# Bumbuket.pku — Environment Variables Template
# Salin ke apps/web/.env.local dan apps/mobile/.env sesuai kebutuhan
# ==============================================================================

# --- Supabase (Web - Next.js) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Supabase (Mobile - Expo) ---
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
EXPO_PUBLIC_API_BASE_URL=https://bumbuket.pku.example.com

# --- Midtrans (Web API Route & Snap UI) ---
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxx

# --- App URL ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

