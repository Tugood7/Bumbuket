# ==============================================================================
# Bumbuket.pku — Environment Variables Production (tubagus-server)
# Salin ke .env.production di server sebelum menjalankan docker compose
# ==============================================================================

# --- Supabase Cloud (WAJIB untuk Database, Storage Gambar, & Login Admin) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Midtrans (Opsional — isi bila ingin aktifkan pembayaran otomatis) ---
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=

# --- Domain Publik (Subdomain) ---
NEXT_PUBLIC_APP_URL=https://bumbuket.tugoodly.my.id

# --- Cloudflare Tunnel Token (Isi bila menggunakan Cloudflare Tunnel) ---
CLOUDFLARE_TUNNEL_TOKEN=

